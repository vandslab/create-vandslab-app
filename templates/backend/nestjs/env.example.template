# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL + TypeORM)
# Option 1: Individual credentials
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME={{PROJECT_NAME}}_db
# TLS. DB_SSL_MODE takes the PostgreSQL sslmode values and means the same
# thing here as it does for psql:
#   disable                    no TLS
#   require | prefer | allow   encrypt, accept any certificate
#   verify-ca                  verify the certificate chain
#   verify-full                verify the chain and the hostname
DB_SSL_MODE=disable
# Shorthand kept for convenience: DB_SSL=true means DB_SSL_MODE=require.
# DB_SSL=false
# PEM certificate, inline. Needed by verify-ca / verify-full when the server
# uses a CA that is not in the system trust store.
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"

# Option 2: Connection URL (overrides individual credentials if provided)
# DATABASE_URL=postgres://user:password@host:5432/database?sslmode=verify-full

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
