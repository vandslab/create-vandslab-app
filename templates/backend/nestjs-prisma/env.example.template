# Server Configuration
PORT=4000
# Swagger (/api/docs) is mounted only when NODE_ENV is exactly "development".
# Anything else — including an unset value — leaves the route unregistered.
NODE_ENV=development

# Database configuration
# Must be a direct connection string — the Prisma 7 driver adapter rejects
# prisma:// and prisma+postgres:// (Accelerate) URLs.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/{{PROJECT_NAME}}?schema=public

# CORS
# Origin allowed to call this API with credentials.
FRONTEND_URL=http://localhost:3000
