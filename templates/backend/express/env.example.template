# Server Configuration
PORT=4000
NODE_ENV=development

# Database configuration
# Must be a direct connection string — the Prisma 7 driver adapter rejects
# prisma:// and prisma+postgres:// (Accelerate) URLs.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/{{PROJECT_NAME}}?schema=public

# CORS
CORS_ORIGIN=http://localhost:3000 #next.js url

# Logging configuration
# Options: trace | debug | info | warn | error | fatal
# - Development: debug (see everything)
# - Staging: info (normal operations)
# - Production: warn or error (only issues)
LOG_LEVEL=info

# JWT configuration
JWT_SECRET=your-secret-key-change-this
JWT_EXPIRES_IN=7d